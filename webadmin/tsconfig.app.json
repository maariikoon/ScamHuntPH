{
    "extends": "./tsconfig.json",
    "compilerOptions": {
      "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
  
      /* Extra paths (so @src works too) */
      "baseUrl": ".",
      "paths": {
        "@/*": ["src/*"],
        "@src/*": ["src/*"]
      },
  
      /* Vite/Env types */
      "types": ["vite/client"]
    },
    "include": ["src", "vite-env.d.ts"]
  }
  